{
  "name": "@workspace/hotel-pms",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "dev:vite": "vite --config vite.config.ts --host 0.0.0.0",
    "seed:fakes": "npm --prefix \"../PalawanSU Hotel/palsu-hotel-server\" run seed:fakes",
    "dev:all": "concurrently \"npm --prefix \\\"../PalawanSU Hotel/palsu-hotel-server\\\" run dev\" \"npm run electron:dev\"",
    "build:vite": "vite build --config vite.config.ts",
    "serve": "vite preview --config vite.config.ts --host 0.0.0.0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "electron:dev": "concurrently \"cross-env VITE_PORT=5173 PORT=5173 BASE_PATH=/ vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "npm run electron:build:server && npm run electron:build:ui && electron-builder",
    "electron:build:host": "npm run electron:build:server && npm run electron:build:ui && electron-builder --config electron-builder.host.json",
    "electron:build:client": "npm run electron:build:server && npm run electron:build:ui && electron-builder --config electron-builder.client.json",
    "electron:build:ui": "cross-env ELECTRON_BUILD=true PORT=5173 BASE_PATH=/ vite build --config vite.config.ts",
    "electron:build:server": "node -e \"require('esbuild').buildSync({ entryPoints: ['../PalawanSU Hotel/palsu-hotel-server/src/index.ts'], bundle: true, platform: 'node', format: 'cjs', outfile: 'dist/server/index.cjs', external: ['electron', 'better-sqlite3'] })\"",
    "electron:pack": "electron-builder --dir"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "geist": "^1.7.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "next": "^15.5.23",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sileo": "^0.1.5"
  },
  "build": {
    "appId": "com.palawansu.hotel",
    "productName": "PalawanSU Hotel",
    "copyright": "Copyright © 2026 PalawanSU Hotel",
    "directories": {
      "output": "dist/electron-dist"
    },
    "files": [
      "electron/**/*",
      "dist/public/**/*",
      "!**/*.db"
    ],
    "extraResources": [
      {
        "from": "dist/server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/better-sqlite3",
        "to": "server/node_modules/better-sqlite3",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/bindings",
        "to": "server/node_modules/bindings",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "node_modules/file-uri-to-path",
        "to": "server/node_modules/file-uri-to-path",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/logo.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/logo.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PalawanSU Hotel"
    }
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@replit/vite-plugin-cartographer": "^0.5.0",
    "@replit/vite-plugin-dev-banner": "^0.1.1",
    "@replit/vite-plugin-runtime-error-modal": "^0.0.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.21",
    "@types/node": "^25.3.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "date-fns": "^3.6.0",
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8",
    "electron-is-dev": "^3.0.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.23.24",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.545.0",
    "next-themes": "^0.4.6",
    "react-day-picker": "^9.11.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "^2.15.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "^7.3.0",
    "wait-on": "^8.0.3",
    "wouter": "^3.3.5",
    "zod": "^3.25.76"
  }
}
